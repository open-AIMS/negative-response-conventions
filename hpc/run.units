#!/bin/bash
#SBATCH --job-name=nrc-units
#SBATCH --partition=cpuq
#SBATCH --array=43-4200%200
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=6GB
#SBATCH --time=02:00:00
#SBATCH --output=logs/nrc-%A_%a.log

# One array task = one (cell, arm, iteration) unit on one dedicated core.
#
# --array=43-4200%200 is the 100-iteration study less the first 42 units, which
# run.warmup does first to populate the compile cache and install the package.
# 200 tasks resident at a time; the study is embarrassingly parallel, so
# throughput scales with that number.
#
# --mem=6GB per task is over-provisioning rather than a measurement. On a
# 64-core, 512GB node the binding constraint is cores, so raising it costs
# nothing in throughput while removing the risk of an OOM kill part-way through.
#
# --time=02:00:00: a unit took 13 minutes on an idle core in the previous run.
# The initial-value search that dominated those times was rewritten in bayesnec
# #312, so units under the pinned commit should be faster rather than slower,
# but the limit is left where it was until that is measured rather than assumed.
#
# Idempotent: run_unit.R skips a unit whose result file exists, so a failed or
# timed-out subset is recovered by resubmitting the same array.

set -euo pipefail
# Sourced by absolute path, not relative to this file: SLURM runs a copy of the
# submitted script from its own spool directory, so $BASH_SOURCE does not point
# into the job directory.
STUDY="${NRC_STUDY:-/export/scratch/$USER/negative-response-conventions}"
source "$STUDY/hpc/job-common.sh"

[ -f "$LIB/.installed" ] || {
  echo "bayesnec is not installed in $LIB; run hpc/run.warmup first" >&2; exit 1; }

nrc_r analysis/run_unit.R "$SLURM_ARRAY_TASK_ID" 100
