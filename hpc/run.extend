#!/bin/bash
#SBATCH --job-name=nrc-ext
#SBATCH --partition=cpuq
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=1
#SBATCH --mem=6GB
#SBATCH --time=02:00:00
#SBATCH --output=logs/nrc-ext-%A_%a.log
#SBATCH --error=logs/nrc-ext-%A_%a.err

# Extend the study past unit 4200. The array range is set at submission by
# hpc/extend.sh, not here.
#
# SLURM caps array indices at MaxArraySize - 1, which is 10000 on this cluster,
# so a 21,000-unit study cannot be one array. UNIT_OFFSET shifts a 1-N array
# onto the unit range it is meant to cover, and the chain in extend.sh submits
# as many arrays as the target needs.
#
# The unit index is stable under a change of target: the queue is
# iteration-major, so unit N is always iteration ceil(N/42) whether the target
# is 100 or 500. Earlier results stay valid and are skipped on the existence
# check.

module load slurm
module load singularity

STUDY=/export/scratch/$USER/negative-response-conventions
cd "$STUDY"; mkdir -p logs
export NRC_STAN_CACHE="$STUDY/cmdstan_cache"

IDX=$(( ${UNIT_OFFSET:-0} + SLURM_ARRAY_TASK_ID ))

singularity exec -B "$STUDY":"$STUDY" --pwd "$STUDY" \
  --env NRC_STAN_CACHE="$NRC_STAN_CACHE" \
  "$STUDY/negative-response-conventions.sif" \
  Rscript analysis/run_unit.R "$IDX" "${N_ITER:-500}"
