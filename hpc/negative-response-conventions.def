Bootstrap: docker
From: rocker/r-ver:4.5.1

# Container for the negative-response-conventions simulation study.
#
# Build here, copy the .sif to the HPC. The AIMS HPC can pull images itself
# (`singularity exec docker://...` works from the login node), but the study
# needs bayesnec from a specific commit, so the image is built once and moved
# rather than reconstructed per job.
#
#   apptainer build negative-response-conventions.sif hpc/negative-response-conventions.def
#
# The base R version is 4.5.1, not the 4.6.1 this was developed against. The
# study does not depend on anything added between them, but the difference is
# recorded here rather than left to be discovered: if a result differs between
# the local run and the container run, this is the first thing to check.

%labels
    Study negative-response-conventions
    Bayesnec_source open-AIMS/bayesnec dev
    Maintainer Rebecca Fisher

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive

    apt-get update && apt-get install -y --no-install-recommends \
        build-essential g++ make \
        libcurl4-openssl-dev libssl-dev libxml2-dev \
        libfontconfig1-dev libharfbuzz-dev libfribidi-dev \
        libfreetype6-dev libpng-dev libtiff5-dev libjpeg-dev \
        git ca-certificates \
        && rm -rf /var/lib/apt/lists/*

    # Stan toolchain. cmdstanr is not on CRAN.
    R -e 'install.packages("cmdstanr", repos = c("https://stan-dev.r-universe.dev", "https://cloud.r-project.org"))'
    mkdir -p /opt/cmdstan
    R -e 'cmdstanr::install_cmdstan(dir = "/opt/cmdstan", cores = 4, version = "2.39.0")'

    R -e 'install.packages(c("brms", "dplyr", "tidyr", "ggplot2"), repos = "https://cloud.r-project.org")'

    # bayesnec at the commit the study is about. Pinned rather than tracking
    # dev: the whole point of this study is to measure one version's behaviour,
    # and a floating install would let that change between blocks.
    R -e 'remotes::install_github("open-AIMS/bayesnec", ref = "0976cacaa50d7c34105f63e346e5a4a8ddf719cd", upgrade = "never")' \
      || R -e 'install.packages("remotes", repos="https://cloud.r-project.org"); remotes::install_github("open-AIMS/bayesnec", ref = "0976cacaa50d7c34105f63e346e5a4a8ddf719cd", upgrade = "never")'

    R -e 'stopifnot(packageVersion("bayesnec") >= "2.1.3.33"); cat("bayesnec", as.character(packageVersion("bayesnec")), "OK\n")'

%environment
    export CMDSTAN=/opt/cmdstan/cmdstan-2.39.0
    export NOT_CRAN=true

%runscript
    exec Rscript "$@"

%test
    R -e 'library(bayesnec); cat("bayesnec", as.character(packageVersion("bayesnec")), "\n")'
    R -e 'cmdstanr::set_cmdstan_path(Sys.getenv("CMDSTAN")); cat("cmdstan", cmdstanr::cmdstan_version(), "\n")'
